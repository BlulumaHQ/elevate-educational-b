// Cloudflare CI must run the build first, then `npx wrangler deploy`.
// `npm run build` force-enables Nitro and writes both:
//   - dist/server/wrangler.json
//   - .wrangler/deploy/config.json
// Bare Wrangler then auto-detects the generated config and deploys the built
// Worker. Wrangler bundling is intentionally enabled so Nitro's generated
// multi-file module graph is validated as one Worker bundle instead of relying
// on Cloudflare's no-bundle module upload path.
//
// Local/CI deploy flow:
//   npm run build && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elevate-educational-b",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "no_bundle": false,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ]
}

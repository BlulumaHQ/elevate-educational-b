// Cloudflare CI must run `vite build` first, then `wrangler deploy`.
// The build force-enables Nitro in vite.config.ts and emits the fully bundled
// Worker here: dist/server/index.mjs. Pointing Wrangler at src/server.ts makes
// Wrangler's own bundler see unresolved TanStack virtual modules.
//
// Local/CI deploy flow:
//   npx vite build && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elevate-educational-b",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ]
}

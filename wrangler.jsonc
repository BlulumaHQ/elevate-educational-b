// Cloudflare CI must run the build first, then `npx wrangler deploy`.
// `npm run build` force-enables Nitro and writes both:
//   - dist/server/wrangler.json
//   - .wrangler/deploy/config.json
// Bare Wrangler then auto-detects the generated config and deploys the built
// Worker. Pointing Wrangler at src/server.ts makes Wrangler's own bundler see
// unresolved TanStack virtual modules.
//
// Local/CI deploy flow:
//   npm run build && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elevate-educational-b",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ]
}
